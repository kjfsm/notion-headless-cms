{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "react", "oxc", "vitest", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // vi.fn() への型パラメータ必須化。既存テストの書き方と合わないため無効化
    "vitest/require-mock-type-parameters": "off"
  },
  "env": {
    "builtin": true
  },
  "options": { "typeAware": true },
  "ignorePatterns": ["worker-configuration.d.ts", "**/components/ui/**", "**/*.hbs"]
}
