{
  "name": "@notion-headless-cms/docs",
  "private": true,
  "version": "0.0.32",
  "description": "notion-headless-cms 公式ドキュメントサイト (dogfooding: LP を nhc 自身で Notion 配信、本体 docs は md 直配信)",
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types && react-router typegen",
    "check": "tsc && react-router build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "react-router dev",
    "env": "dotenv -e .dev.vars",
    "generate": "nhc generate",
    "preview": "pnpm run build && vite preview",
    "test": "vitest run",
    "test:screenshots": "PLAYWRIGHT_HTML_OPEN=never playwright test",
    "test:e2e": "PLAYWRIGHT_HTML_OPEN=never playwright test e2e/navigation.spec.ts",
    "typecheck": "tsc -b",
    "wrangler:dev": "wrangler dev"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@notion-headless-cms/client": "workspace:*",
    "@notion-headless-cms/core": "workspace:*",
    "@notion-headless-cms/notion-orm": "workspace:*",
    "@notion-headless-cms/notion-source": "workspace:*",
    "@notion-headless-cms/react-renderer": "workspace:*",
    "@notionhq/client": "catalog:",
    "@shikijs/rehype": "^4.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "clsx": "^2.1.1",
    "dotenv": "catalog:",
    "katex": "catalog:",
    "lucide-react": "^1.16.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^7.15.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "catalog:",
    "remark-gfm": "catalog:",
    "remark-parse": "catalog:",
    "remark-rehype": "catalog:",
    "shiki": "catalog:",
    "tailwind-merge": "^3.6.0",
    "unified": "catalog:",
    "unist-util-visit": "^5.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@notion-headless-cms/cli": "workspace:*",
    "@playwright/test": "catalog:",
    "@react-router/dev": "^7.15.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "dotenv-cli": "^11.0.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.0.13",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
