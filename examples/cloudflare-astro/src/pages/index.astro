---
import { env } from "cloudflare:workers";
import { type Env, makeCms } from "../lib/cms";
import { getPosts } from "../lib/data";

const cms = makeCms(env as Env, Astro.locals.cfContext);
const { items } = await getPosts(cms);
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>Notion Blog</title>
  </head>
  <body>
    <main>
      <h1>記事一覧</h1>
      <ul>
        {items.map((post) => {
          const meta = post.meta as { publishedAt?: string | null };
          return (
            <li>
              <a href={`/posts/${post.slug}`}>
                <strong>{post.slug}</strong>
                {meta.publishedAt && <time>{meta.publishedAt}</time>}
              </a>
            </li>
          );
        })}
      </ul>
    </main>
    <script>
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") location.reload();
      });
    </script>
  </body>
</html>
