{
  "name": "example-cloudflare-hono",
  "version": "0.0.65",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "echo 'Hono は src/index.ts を wrangler が直接バンドルするため build は不要'",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:screenshots": "PLAYWRIGHT_HTML_OPEN=never playwright test",
    "typecheck": "tsc -b",
    "test:e2e": "PLAYWRIGHT_HTML_OPEN=never playwright test e2e/navigation.spec.ts"
  },
  "dependencies": {
    "@notion-headless-cms/cms": "workspace:*",
    "@notion-headless-cms/sql": "workspace:*",
    "hono": "catalog:",
    "kysely-d1": "^0.4.0"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
