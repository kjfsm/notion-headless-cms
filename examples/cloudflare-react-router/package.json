{
  "name": "example-cloudflare-react-router",
  "version": "0.0.78",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types && react-router typegen",
    "check": "tsc && react-router build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "react-router dev",
    "preview": "pnpm run build && vite preview",
    "wrangler:dev": "rm -f .wrangler/deploy/config.json && pnpm run build && wrangler dev",
    "test": "vitest run",
    "test:screenshots": "PLAYWRIGHT_HTML_OPEN=never playwright test",
    "typecheck": "tsc -b",
    "test:e2e": "PLAYWRIGHT_HTML_OPEN=never playwright test e2e/navigation.spec.ts"
  },
  "dependencies": {
    "@notion-headless-cms/cms": "workspace:*",
    "@notion-headless-cms/react-renderer": "workspace:*",
    "katex": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8.3.0",
    "shiki": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@playwright/test": "catalog:",
    "@react-router/dev": "^7.15.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.0.13",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
