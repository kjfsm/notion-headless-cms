{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "cf-typegen": {
      "inputs": ["wrangler.toml", "react-router.config.ts"],
      "outputs": ["worker-configuration.d.ts", ".react-router/types/**"]
    },
    "typecheck": {
      "dependsOn": ["cf-typegen"]
    }
  }
}
