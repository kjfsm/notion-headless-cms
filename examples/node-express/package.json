{
  "name": "example-node-express",
  "private": true,
  "version": "0.0.70",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc",
    "seed": "tsx scripts/seed-test-page.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:screenshots": "PLAYWRIGHT_HTML_OPEN=never playwright test",
    "test:e2e": "PLAYWRIGHT_HTML_OPEN=never playwright test e2e/navigation.spec.ts"
  },
  "dependencies": {
    "@notion-headless-cms/cms": "workspace:*",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@notionhq/client": "catalog:",
    "@playwright/test": "catalog:",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.0",
    "dotenv": "catalog:",
    "supertest": "^7.2.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
