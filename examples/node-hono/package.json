{
  "name": "example-node-hono",
  "private": true,
  "version": "0.0.55",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc",
    "generate": "nhc generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:screenshots": "PLAYWRIGHT_HTML_OPEN=never playwright test",
    "test:e2e": "PLAYWRIGHT_HTML_OPEN=never playwright test e2e/navigation.spec.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@notion-headless-cms/client": "workspace:*",
    "@notion-headless-cms/core": "workspace:*",
    "@notion-headless-cms/fetch-markdown": "workspace:*",
    "@notion-headless-cms/notion-orm": "workspace:*",
    "@notion-headless-cms/notion-source": "workspace:*",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@notion-headless-cms/cli": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
