{
  "name": "@notion-headless-cms/cli",
  "version": "3.0.7",
  "description": "CLI tool for notion-headless-cms — schema drift check, scaffold, sync and doctor for @notion-headless-cms/cms",
  "keywords": [
    "cli",
    "headless-cms",
    "notion",
    "typescript"
  ],
  "homepage": "https://github.com/kjfsm/notion-headless-cms#readme",
  "bugs": {
    "url": "https://github.com/kjfsm/notion-headless-cms/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjfsm/notion-headless-cms.git",
    "directory": "packages/cli"
  },
  "bin": {
    "nhc": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsdown src/index.ts src/cli.ts --format esm --dts --sourcemap --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only",
    "release:local": "pnpm publish --no-provenance --no-git-checks"
  },
  "dependencies": {
    "@notion-headless-cms/cms": "workspace:*",
    "@notionhq/client": "catalog:",
    "commander": "^15.0.0",
    "dotenv": "catalog:",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
