{
  "name": "@notion-headless-cms/client",
  "version": "0.3.7",
  "description": "notion-headless-cms 単一エントリ — createCMS で schema(構造) と振る舞いを分離して組み立てる",
  "keywords": [
    "notion",
    "headless-cms",
    "client",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kjfsm/notion-headless-cms#readme",
  "bugs": {
    "url": "https://github.com/kjfsm/notion-headless-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjfsm/notion-headless-cms.git",
    "directory": "packages/client"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "import": "./dist/next.mjs"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.mts",
      "import": "./dist/cloudflare.mjs"
    },
    "./react": {
      "types": "./dist/react.d.mts",
      "import": "./dist/react.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/next.ts src/cloudflare.ts src/react.ts --format esm --dts --sourcemap --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --passWithNoTests --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only",
    "release:local": "pnpm publish --no-provenance --no-git-checks"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@notion-headless-cms/core": "workspace:*",
    "@notion-headless-cms/notion-source": "workspace:*",
    "@notion-headless-cms/fetch-markdown": "workspace:*",
    "@notion-headless-cms/fetch-blocks": "workspace:*",
    "@notion-headless-cms/cache": "workspace:*",
    "@notion-headless-cms/react-renderer": "workspace:*",
    "@notionhq/client": "^5.20.0",
    "notion-to-md": "^3.1.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": ">=7"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  }
}
