{
  "name": "@notion-headless-cms/cms",
  "version": "3.0.7",
  "description": "notion-headless-cms v3 — マテリアライズドコンテンツレプリカ + 非同期同期。読者リクエスト中に Notion API を呼ばない",
  "keywords": [
    "cms",
    "headless-cms",
    "notion",
    "typescript"
  ],
  "homepage": "https://github.com/kjfsm/notion-headless-cms#readme",
  "bugs": {
    "url": "https://github.com/kjfsm/notion-headless-cms/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjfsm/notion-headless-cms.git",
    "directory": "packages/cms"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./html": {
      "types": "./dist/html.d.mts",
      "import": "./dist/html.mjs"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.mts",
      "import": "./dist/cloudflare.mjs"
    },
    "./node": {
      "types": "./dist/node.d.mts",
      "import": "./dist/node.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown src/index.ts src/html.ts src/cloudflare.ts src/node.ts src/testing.ts --format esm --dts --sourcemap --out-dir dist --external vitest",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only",
    "release:local": "pnpm publish --no-provenance --no-git-checks"
  },
  "devDependencies": {
    "@notionhq/client": "catalog:",
    "@types/node": "catalog:",
    "katex": "catalog:",
    "shiki": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@notionhq/client": "^5.20.0",
    "katex": "^0.16.11",
    "shiki": "^4.0.2",
    "vitest": "^4"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
