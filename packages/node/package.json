{
  "name": "@notion-headless-cms/node",
  "version": "1.0.0",
  "description": "Node.js 向け notion-headless-cms メタパッケージ — createCms と nodePreset を一括提供",
  "keywords": [
    "notion",
    "headless-cms",
    "node",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kjfsm/notion-headless-cms#readme",
  "bugs": {
    "url": "https://github.com/kjfsm/notion-headless-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjfsm/notion-headless-cms.git",
    "directory": "packages/node"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --sourcemap --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@notion-headless-cms/core": "workspace:*",
    "@notion-headless-cms/notion-source": "workspace:*",
    "@notion-headless-cms/markdown-html": "workspace:*"
  },
  "peerDependencies": {
    "@notionhq/client": "^5.20.0",
    "zod": "^4.0.0"
  }
}
