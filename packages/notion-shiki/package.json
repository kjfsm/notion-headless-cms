{
  "name": "@notion-headless-cms/notion-shiki",
  "version": "0.1.0",
  "description": "Notion code ブロックを fetch 時に shiki で pre-render し、Workers バンドルから shiki を除外する拡張パッケージ",
  "keywords": [
    "notion",
    "headless-cms",
    "shiki",
    "syntax-highlight",
    "code",
    "pre-render",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kjfsm/notion-headless-cms#readme",
  "bugs": {
    "url": "https://github.com/kjfsm/notion-headless-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjfsm/notion-headless-cms.git",
    "directory": "packages/notion-shiki"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --sourcemap --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@notion-headless-cms/notion-orm": "workspace:*",
    "shiki": "^1.0.0"
  },
  "devDependencies": {
    "@notion-headless-cms/notion-orm": "workspace:*",
    "shiki": "^1.0.0"
  }
}
