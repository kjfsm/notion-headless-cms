{
  "name": "@notion-headless-cms/react-renderer",
  "version": "3.0.2",
  "description": "Notion ブロックを React コンポーネントとして直接描画するレンダラ。shadcn/ui + Tailwind v4 ベース。",
  "keywords": [
    "notion",
    "headless-cms",
    "react",
    "renderer",
    "shadcn",
    "tailwindcss",
    "typescript"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kjfsm/notion-headless-cms#readme",
  "bugs": {
    "url": "https://github.com/kjfsm/notion-headless-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjfsm/notion-headless-cms.git",
    "directory": "packages/react-renderer"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./router": {
      "types": "./dist/router.d.mts",
      "import": "./dist/router.mjs"
    },
    "./next": {
      "types": "./dist/next.d.mts",
      "import": "./dist/next.mjs"
    },
    "./mermaid": {
      "types": "./dist/mermaid.d.mts",
      "import": "./dist/mermaid.mjs"
    },
    "./v3": {
      "types": "./dist/v3.d.mts",
      "import": "./dist/v3.mjs"
    },
    "./theme.css": "./styles/theme.css"
  },
  "files": [
    "dist",
    "styles"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/server.ts src/router.tsx src/next.tsx src/mermaid.tsx src/v3.ts --format esm --dts --sourcemap --out-dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only",
    "release:local": "pnpm publish --no-provenance --no-git-checks"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@notionhq/client": "^5.20.0",
    "katex": "^0.16.11",
    "mermaid": "^11.0.0",
    "next": ">=14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": ">=7",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@notionhq/client": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "shiki": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@notion-headless-cms/cms": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "radix-ui": "^1.4.3",
    "swr": "^2.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@notionhq/client": "catalog:",
    "@testing-library/react": "^16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "^20.9.0",
    "katex": "catalog:",
    "next": "^16.2.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^7.15.1",
    "shiki": "catalog:"
  }
}
