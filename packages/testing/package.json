{
  "name": "@notion-headless-cms/testing",
  "version": "0.3.11",
  "description": "Testing utilities for notion-headless-cms — fake DataSource, fake cache, and fixture clients.",
  "keywords": [
    "notion",
    "headless-cms",
    "testing",
    "fake",
    "fixture"
  ],
  "license": "MIT",
  "homepage": "https://github.com/kjfsm/notion-headless-cms#readme",
  "bugs": {
    "url": "https://github.com/kjfsm/notion-headless-cms/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjfsm/notion-headless-cms.git",
    "directory": "packages/testing"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./contract": {
      "types": "./dist/contract.d.mts",
      "import": "./dist/contract.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/contract.ts --format esm --dts --sourcemap --out-dir dist --external vitest",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "publint": "publint --strict",
    "attw": "attw --pack . --profile esm-only",
    "release:local": "pnpm publish --no-provenance --no-git-checks"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@notion-headless-cms/core": "workspace:*"
  },
  "peerDependencies": {
    "vitest": "^4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {}
}
